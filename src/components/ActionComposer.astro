---
import { ACCESS_FACTORS, ACTIVITIES, CONNECTIONS } from '../lib/activities';
import { mailtoLink } from '../lib/prompt';
import { siteConfig } from '../lib/site-config';
import { toPromptCampaign, type Campaign } from '../lib/campaigns';
import { solicitsComments } from '../lib/campaign-validation';
import type { ComposerData } from '../lib/composer-client';

interface Props {
  campaign: Campaign;
}
const { campaign } = Astro.props;
const open = solicitsComments(campaign.data);
const data: ComposerData = {
  campaign: toPromptCampaign(campaign),
  chatgpt: {
    baseUrl: siteConfig.chatbots.chatgptUrl,
    prefill: siteConfig.chatbots.chatgptPrefill,
    maxUrlLength: siteConfig.chatbots.maxPrefillUrlLength,
  },
  claude: { baseUrl: siteConfig.chatbots.claudeUrl },
  gemini: { baseUrl: siteConfig.chatbots.geminiUrl },
};
// Safe to embed in a <script type="application/json">: escape "<" so nothing can close the tag.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const id = campaign.id;
const s = campaign.data.submission;
---

<div class="composer" data-composer>
  <script type="application/json" data-composer-data set:html={json} />

  {
    !open && (
      <div class="notice notice-warn">
        <p>
          <strong>Practice mode.</strong> This campaign's decision-maker and submission route haven't been
          verified yet. You can try the drafting tool, but please don't send anything until this page says
          the campaign is open for comment.
        </p>
      </div>
    )
  }

  <noscript>
    <p class="notice">
      The AI drafting helper needs JavaScript. You can still use the talking points and outline under{' '}
      <a href="#write-without-ai">Write without AI</a>.
    </p>
  </noscript>

  <div data-composer-ui hidden>
    <p>
      Answer a few optional questions. We turn your answers and this campaign's asks into a prompt you paste
      into ChatGPT, Claude or Gemini, which drafts a comment in your words. Nothing you enter is sent to this site
      or saved.
    </p>

    <form onsubmit="return false" aria-describedby={`privacy-${id}`}>
      <fieldset>
        <legend>What's your connection to {campaign.data.place}? <span class="hint">Optional. Pick one.</span></legend>
        <div class="checkbox-grid">
          {
            CONNECTIONS.map((c) => (
              <label>
                <input type="radio" name="connection" value={c.id} />
                {c.label}
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend>How do you use {campaign.data.place}? <span class="hint">Optional. Choose any that apply, or none.</span></legend>
        <div class="checkbox-grid">
          {
            ACTIVITIES.map((a) => (
              <label>
                <input type="checkbox" name="activity" value={a.id} />
                {a.label}
              </label>
            ))
          }
        </div>
        <div class="field" style="margin-top:0.75rem;margin-bottom:0">
          <label class="field-label" for={`other-${id}`}>Other activity <span class="hint" style="display:inline">(optional)</span></label>
          <input type="text" id={`other-${id}`} name="other_activity" maxlength="200" autocomplete="off" />
        </div>
      </fieldset>

      <fieldset>
        <legend>How does this decision affect your access? <span class="hint">Optional. Check only what's true for you.</span></legend>
        <div class="checkbox-grid">
          {
            ACCESS_FACTORS.map((f) => (
              <label>
                <input type="checkbox" name="factor" value={f.id} />
                {f.label}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field">
        <label class="field-label" for={`concern-${id}`}>What would you like the decision-makers to understand? <span class="hint" style="display:inline">(optional)</span></label>
        <textarea id={`concern-${id}`} name="concern" maxlength="2000"></textarea>
      </div>

      <p class="hint" id={`privacy-${id}`}>
        <strong>Privacy:</strong> don't include your address, phone number or email here. What you paste into
        ChatGPT, Claude or Gemini is covered by that company's privacy policy, not this site's. Both may ask you to sign
        in, and free accounts have usage limits.
      </p>

      <ol class="steps">
        <li>
          <h4 class="step-title">Copy your prompt</h4>
          <p class="hint">
            This turns your answers and the campaign's asks into instructions for a chatbot. You'll choose
            ChatGPT, Claude or Gemini in the next step.
          </p>
          <div class="button-row">
            <button type="button" class="button button-large" data-copy-prompt>Copy prompt</button>
          </div>
          <p class="status-message" role="status" aria-live="polite" data-status></p>
        </li>
        <li>
          <h4 class="step-title">Open a chatbot and paste it</h4>
          <p class="hint">
            Click the message box and paste (<kbd>Ctrl</kbd>+<kbd>V</kbd> or <kbd>⌘</kbd>+<kbd>V</kbd>; on a phone,
            press and hold, then Paste).
          </p>
          <div class="button-row">
            <a class="button button-secondary" data-open="chatgpt" href={siteConfig.chatbots.chatgptUrl} target="_blank" rel="noopener noreferrer">
              Open ChatGPT<span class="sr-only"> (new tab)</span>
            </a>
            <a class="button button-secondary" data-open="claude" href={siteConfig.chatbots.claudeUrl} target="_blank" rel="noopener noreferrer">
              Open Claude<span class="sr-only"> (new tab)</span>
            </a>
            <a class="button button-secondary" data-open="gemini" href={siteConfig.chatbots.geminiUrl} target="_blank" rel="noopener noreferrer">
              Open Gemini<span class="sr-only"> (new tab)</span>
            </a>
          </div>
        </li>
        <li>
          <h4 class="step-title">Make it yours, then send it yourself</h4>
          <p>
            The chatbot will ask if you want changes. Keep going until the letter sounds like you wrote it:
            angrier or calmer, shorter or more detailed, or leading with the point you care about most. For
            example: "Make it more passionate and put parking first." Personal notes carry more weight than
            form letters.
          </p>
          {
            open && s.type === 'email' && s.email ? (
              <p>
                Fix anything that isn't true, then email it to{' '}
                <a href={mailtoLink(s.email, s.subject ?? campaign.data.title)}>{s.email}</a>
                {s.subject && <> with the subject “{s.subject}”</>}. The chatbot can't send it for you.
              </p>
            ) : (
              <p>Fix anything that isn't true, then send it through the route under "Who can act." The chatbot can't send it for you.</p>
            )
          }
        </li>
      </ol>

      <p class="hint">Prefer to write it yourself? <a href="#write-without-ai">Write without AI</a></p>

      <details data-prompt-details>
        <summary>See the full prompt</summary>
        <label class="field-label" for={`prompt-${id}`}>Prompt (updates as you answer)</label>
        <textarea id={`prompt-${id}`} class="prompt-text" readonly data-prompt-text></textarea>
      </details>
    </form>
  </div>
</div>

<script>
  import { initComposer } from '../lib/composer-client';
  document.querySelectorAll<HTMLElement>('[data-composer]').forEach((el) => initComposer(el));
</script>
