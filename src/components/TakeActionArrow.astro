---
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="take-action-arrow" href={href} data-take-action>
  <svg class="take-action-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path d="M17 4h14v22h11L24 45 6 26h11z" fill="currentColor" />
  </svg>
  <span class="take-action-label">Take Action<span class="sr-only">: jump to the comment form</span></span>
</a>

<script>
  // Down: the comment section is below. Left: it's on screen (from its heading through the
  // no-AI outline). Up: the visitor has scrolled past it. Clicking always jumps to the heading.
  const arrow = document.querySelector<HTMLAnchorElement>('[data-take-action]');
  const hash = arrow?.getAttribute('href') ?? '';
  const heading = hash.startsWith('#') ? document.getElementById(hash.slice(1)) : null;
  const section = heading?.closest('section') ?? heading;

  if (arrow && heading && section) {
    let frame = 0;

    const place = () => {
      frame = 0;
      const vh = window.innerHeight;
      const area = section.getBoundingClientRect();
      const below = area.top >= vh;
      const above = area.bottom <= 0;
      arrow.classList.toggle('is-pointing', !below && !above);
      arrow.classList.toggle('is-up', above);
      if (below || above) {
        arrow.style.removeProperty('top');
        return;
      }
      const half = arrow.offsetHeight / 2;
      const h = heading.getBoundingClientRect();
      const headingCenter = h.top + h.height / 2;
      // Track the heading while it's visible, then hold mid-screen, then follow the section's end up.
      const y = headingCenter > half + 8 ? headingCenter : Math.min(vh / 2, area.bottom - half);
      arrow.style.top = `${Math.min(Math.max(y, half + 8), vh - half - 8)}px`;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(place);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    schedule();

    arrow.addEventListener('click', () => {
      // Move keyboard and screen-reader focus to the heading after the jump.
      window.setTimeout(() => heading.focus({ preventScroll: true }), 0);
    });
  }
</script>
